<mujoco model="scene_table">
  <include file="so101.xml"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="160" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0"
             width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge"
             rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8"
             width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true"
              texrepeat="5 5" reflectance="0.2"/>
    <material name="table_mat" rgba="0.8 0.7 0.6 1"/>
    <material name="cube_mat"  rgba="1.0 0.3 0.2 1"/>
  </asset>

  <worldbody>
    <light pos="0 0 2.0" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>

    <!-- External camera for the vision policy: a fixed 3/4 view from the front
         that sees the whole workspace (arm, cube, green target). targetbody
         auto-aims it at the table. fovy zooms in so the cube/target are large
         enough to localize at low resolution. -->
    <camera name="external" pos="0.55 -0.30 0.36" fovy="38" mode="targetbody" target="table"/>

    <!-- Table surface is at z=0 so the arm base (fixed at world origin) sits on top. -->
    <!-- The slab extends downward (underground, invisible below the floor).          -->
    <!--   body at (0.20, 0, 0), geom offset (0, 0, -0.025)                          -->
    <!--   top face  z = 0 - 0.025 + 0.025 = 0   ← arm base level                  -->
    <!--   x range [0.00, 0.40],  y range [-0.20, 0.20]                              -->
    <body name="table" pos="0.20 0 0">
      <geom type="box" size="0.20 0.20 0.025" pos="0 0 -0.025" material="table_mat" mass="10"/>
    </body>

    <!-- Cube sitting on the table surface (z=0)                -->
    <!--   cube centre z = 0 + half-size 0.02 = 0.02           -->
    <!--   x=0.25 = middle of reach,  y=0 = straight ahead     -->
    <body name="cube" pos="0.25 0.0 0.015">
      <freejoint name="cube_joint"/>
      <geom type="box" size="0.015 0.015 0.015" material="cube_mat"
            mass="0.05" friction="1.0 0.05 0.01"/>
      <site name="cube_center" pos="0 0 0"/>
    </body>

    <!-- Drop-target marker: a flat green disk, repositioned each episode in
         goal-conditioned mode (env writes model.site_pos). Visual only. -->
    <site name="target_marker" pos="0.20 -0.13 0.001" type="cylinder"
          size="0.04 0.001" rgba="0 0.8 0.2 0.5"/>
  </worldbody>

</mujoco>
